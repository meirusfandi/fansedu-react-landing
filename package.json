{
  "name": "fansedu-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "favicon": "node scripts/build-favicon.mjs",
    "prebuild": "node scripts/build-favicon.mjs",
    "dev": "vite",
    "dev:dev": "vite --mode dev",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "preview": "vite preview",
    "test": "esbuild tests/unit/*.test.ts tests/integration/*.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env='{}' --outdir=tests/dist --out-extension:.js=.mjs && node --test tests/dist/unit/*.test.mjs tests/dist/integration/*.test.mjs",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
